# ─── Server environment variables ─────────────────────────────────────────────
PORT=3001

# Turso Database (libSQL)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Client URL for CORS (optional, leave blank or set to your frontend domain)
CLIENT_URL=https://form-with-react-my-sql-node-js-boot.vercel.app
